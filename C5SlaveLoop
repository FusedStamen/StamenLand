// Simple Slave Loop
void loop() {
  int n = WiFi.scanNetworks(false, true); // Dual-band scan
  for (int i = 0; i < n; ++i) {
    // Format: MAC, SSID, Auth, Channel, RSSI, Band
    Serial.printf("%s,%s,%d,%d,%d,5G\n", 
      WiFi.BSSIDstr(i).c_str(), WiFi.SSID(i).c_str(), 
      WiFi.encryptionType(i), WiFi.channel(i), WiFi.RSSI(i));
  }
  delay(100); // Short breather to prevent bus flooding
}
