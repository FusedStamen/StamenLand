// In the Master's Loop or a background Task
void checkSlaves() {
  if (Serial1.available()) {
    String slaveData = Serial1.readStringUntil('\n');
    logToSD(slaveData); // Integrate slave data into the Wigle CSV
  }
  if (Serial2.available()) {
    String slaveData = Serial2.readStringUntil('\n');
    logToSD(slaveData);
  }
}
